# Copy this file to `keystore.properties` (same folder) and fill in your
# real values. `keystore.properties` itself is git-ignored — never commit
# your actual keystore path, passwords, or key alias.
#
# If you don't have a release keystore yet, generate one with:
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore nextgen-release.keystore \
#     -alias nextgen \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the resulting .keystore file OUTSIDE version control, and back it up
# somewhere safe — if you lose it, you can never publish an update to an
# app already live on the Play Store under the same applicationId; you'd
# have to ship as a new app listing instead.

storeFile=../nextgen-release.keystore
storePassword=CHANGE_ME
keyAlias=nextgen
keyPassword=CHANGE_ME

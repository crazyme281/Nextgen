# Copy to .env for local work. On Vercel, add the same names under
# Project Settings > Environment Variables (Production, Preview, Development).
# Only values meant for the browser belong here. Never put a service-role key in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# HTTPS URL of the Zorah AI backend (must be https, the site is served over https)
VITE_AI_BACKEND_URL=

# Paystack public key (pk_live_... or pk_test_...), needed for card verification
VITE_PAYSTACK_PUBLIC_KEY=
